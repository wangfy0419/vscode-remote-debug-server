class RemoteSerialMcpServer(object):
    def __init__(self, default_endpoint=None):
        self.session = SerialTcpSession()
        self.default_endpoint = canonical_endpoint(default_endpoint or os.environ.get("REMOTE_SERIAL_ENDPOINT") or DEFAULT_ENDPOINT)

    def call_tool(self, name, arguments):
        arguments = arguments or {}
        if name == "serial_open":
            return self.session.open(arguments.get("endpoint") or self.default_endpoint, arguments.get("timeout", 10))
        if name == "serial_close":
            self.session.close()
            return self.session.status()
        if name == "serial_status":
            return self.session.status()
        if name == "serial_clear":
            return self.session.clear()
        if name == "serial_read":
            data = self.session.read(arguments.get("timeout", 0.2), arguments.get("max_bytes", 65536), arguments.get("consume", True))
            result = payload_result(data)
            result["connected"] = self.session.connected()
            return result
        if name == "serial_write":
            data = arguments["text"].encode("utf-8") + line_ending_bytes(arguments.get("line_ending", "none"))
            return {"bytes_written": self.session.write(data)}
        if name == "serial_write_hex":
            cleaned = re.sub(r"[\s,:_-]+", "", arguments["hex"])
            try:
                data = binascii.unhexlify(cleaned)
            except (TypeError, binascii.Error):
                raise ValueError("hex must contain complete hexadecimal byte pairs")
            return {"bytes_written": self.session.write(data)}
        if name == "serial_wait_for":
            data, truncated = self.session.wait_for(arguments["pattern"], arguments.get("timeout", 30), consume=arguments.get("consume", True))
            return payload_result(data, truncated)
        if name == "serial_command":
            start = self.session.mark()
            data = arguments["command"].encode("utf-8") + line_ending_bytes(arguments.get("line_ending", "cr"))
            written = self.session.write(data)
            response, truncated = self.session.wait_for(arguments.get("prompt_pattern", r"(?m).*[#$>]\s*$"), arguments.get("timeout", 30), start_offset=start)
            result = payload_result(response, truncated)
            result["bytes_written"] = written
            return result
        if name == "serial_enter_uboot":
            return self._serial_enter_uboot(arguments)
        raise ValueError("unknown tool: {0}".format(name))

    def _serial_enter_uboot(self, arguments):
        reboot_command = arguments.get("reboot_command", "reboot")
        enter_window = float(arguments.get("enter_window", 60))
        enter_interval = float(arguments.get("enter_interval", 0.1))
        prompt_pattern = arguments.get("prompt_pattern", r"(?m).*(#|=>)\s*$")
        prompt_timeout = float(arguments.get("prompt_timeout", 30))
        if enter_window <= 0 or enter_interval <= 0:
            raise ValueError("enter_window and enter_interval must be positive")
        start = self.session.mark()
        self.session.write(reboot_command.encode("utf-8") + b"\r")
        deadline = time.monotonic() + enter_window
        enters_sent = 0
        while time.monotonic() < deadline:
            self.session.write(b"\r")
            enters_sent += 1
            remaining = min(enter_interval, max(0.0, deadline - time.monotonic()))
            try:
                response, truncated = self.session.wait_for(prompt_pattern, remaining, start_offset=start)
                result = payload_result(response, truncated)
                result["enters_sent"] = enters_sent
                return result
            except RuntimeError as error:
                if not str(error).startswith("timed out waiting"):
                    raise
        response, truncated = self.session.wait_for(prompt_pattern, prompt_timeout, start_offset=start)
        result = payload_result(response, truncated)
        result["enters_sent"] = enters_sent
        return result

    def handle(self, request):
        method = request.get("method")
        request_id = request.get("id")
        if method == "initialize":
            return {"jsonrpc": "2.0", "id": request_id, "result": {"protocolVersion": PROTOCOL_VERSION, "capabilities": {"tools": {"listChanged": False}}, "serverInfo": {"name": SERVER_NAME, "version": SERVER_VERSION}, "instructions": "Call serial_open without asking for an endpoint; it defaults to 127.0.0.1:39001. Ask for the endpoint shown in Remote Debug only if the default port is unavailable. serial_command sends the command unchanged and waits for prompt_pattern; use serial_enter_uboot for the bootloader entry sequence."}}
        if method == "ping":
            return {"jsonrpc": "2.0", "id": request_id, "result": {}}
        if method == "tools/list":
            return {"jsonrpc": "2.0", "id": request_id, "result": {"tools": TOOLS}}
        if method == "tools/call":
            parameters = request.get("params") or {}
            try:
                result = self.call_tool(parameters.get("name"), parameters.get("arguments") or {})
                return {"jsonrpc": "2.0", "id": request_id, "result": {"content": [{"type": "text", "text": json.dumps(result, ensure_ascii=False, sort_keys=True)}]}}
            except Exception as error:
                return {"jsonrpc": "2.0", "id": request_id, "result": {"content": [{"type": "text", "text": str(error)}], "isError": True}}
        if request_id is None:
            return None
        return {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32601, "message": "Method not found: {0}".format(method)}}

    def run(self):
        try:
            for raw_line in sys.stdin:
                try:
                    request = json.loads(raw_line)
                    response = self.handle(request)
                except Exception as error:
                    response = {"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "Parse error: {0}".format(error)}}
                if response is not None:
                    sys.stdout.write(json.dumps(response, ensure_ascii=False, separators=(",", ":")) + "\n")
                    sys.stdout.flush()
        finally:
            self.session.close()


def build_parser():
    parser = argparse.ArgumentParser(description="Interactive terminal (default) or MCP server for Remote Debug Serial.")
    parser.add_argument("endpoint", nargs="?", help="terminal endpoint as HOST:PORT, or HOST when PORT is separate")
    parser.add_argument("port", nargs="?", help="optional separate terminal TCP port")
    parser.add_argument("--mcp", action="store_true", help="run as a stdio MCP server")
    parser.add_argument("--timestamps", action="store_true", help="prefix each received serial line with a local timestamp")
    parser.add_argument("--log-file", help="append received serial output to this file")
    parser.add_argument("--connect-timeout", type=float, default=10.0, help="connection timeout in seconds (default: 10)")
    return parser


def run_terminal_main(arguments, parser):
    try:
        endpoint = "{0}:{1}".format(*parse_target(arguments.endpoint or os.environ.get("REMOTE_SERIAL_ENDPOINT") or DEFAULT_ENDPOINT, arguments.port))
    except ValueError as error:
        parser.error(str(error))
    input_fd = sys.stdin.fileno()
    output_fd = sys.stdout.fileno()
    interactive = os.isatty(input_fd)
    log_file = os.path.abspath(arguments.log_file) if arguments.log_file else None
    log_handle = None
    if log_file:
        log_directory = os.path.dirname(log_file)
        if log_directory:
            os.makedirs(log_directory, 0o755, exist_ok=True)
        log_handle = open(log_file, "ab", buffering=0)
        print("Serial log file: {0}".format(log_file), file=sys.stderr)
        print("Serial log directory: {0}".format(os.path.dirname(log_file)), file=sys.stderr)
        print("Serial log filename: {0}".format(os.path.basename(log_file)), file=sys.stderr)
    print("Connecting to {0}...".format(endpoint), file=sys.stderr)
    try:
        connection, broker, role = open_shared_connection(endpoint, arguments.connect_timeout)
    except (OSError, RuntimeError) as error:
        if log_handle is not None:
            log_handle.close()
        print("Connection failed: {0}".format(error), file=sys.stderr)
        return 1
    print("Connected through local broker ({0}).{1}".format(role, " Press Ctrl+] to exit." if interactive else ""), file=sys.stderr)

    def stop(_signum, _frame):
        try:
            connection.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    try:
        with TerminalMode(input_fd):
            return run_terminal(connection, input_fd, output_fd, interactive, arguments.timestamps, log_handle.fileno() if log_handle is not None else None)
    except KeyboardInterrupt:
        return 130
    except OSError as error:
        print("\nConnection error: {0}".format(error), file=sys.stderr)
        return 1
    finally:
        try:
            connection.close()
        finally:
            if broker is not None:
                broker.stop()
            if log_handle is not None:
                log_handle.close()
        if interactive:
            print("\nDisconnected.", file=sys.stderr)


def main():
    parser = build_parser()
    arguments = parser.parse_args()
    if arguments.mcp:
        if arguments.endpoint is not None or arguments.port is not None:
            parser.error("--mcp does not accept an endpoint; pass HOST:PORT to serial_open")
        RemoteSerialMcpServer().run()
        return 0
    return run_terminal_main(arguments, parser)


if __name__ == "__main__":
    sys.exit(main())
